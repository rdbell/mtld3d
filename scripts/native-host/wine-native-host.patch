+/* Versioned opt-in contract for native hosts. Called only on the AppKit thread.
+ * The host owns its lifetime and must clear the association before releasing it.
+ * The existing Wine input view and Metal surface remain attached to this window. */
+__attribute__((visibility("default")))
+int macdrv_set_native_host_v1(void *child, void *native_host)
+{
+    WineWindow *window;
+    if (![NSThread isMainThread] || !child) return 0;
+    window = (WineWindow*)child;
+    if (![window isKindOfClass:[WineWindow class]]) return 0;
+    if (native_host && ([window parentWindow] || window.nativeHostWindow ||
+        ![(id)native_host respondsToSelector:@selector(nativeHostMiniaturizeFromWine:)])) return 0;
+    window.nativeHostWindow = (NSWindow*)native_host;
+    return 1;
+}
